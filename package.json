{
  "name": "animation-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @animation/server",
    "dev:web": "npm run dev -w @animation/web",
    "start": "npm run start -w @animation/server",
    "build": "npm run typecheck && npm run build -w @animation/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.8",
    "vitest": "^3.1.1"
  }
}
